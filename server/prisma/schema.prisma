generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  passwordHash       String    @map("password_hash")
  avatar             String?
  role               Role      @default(VIEWER)
  canInvite          Boolean   @default(false)
  company            String?
  phone              String?
  department         String?
  address            String?
  bio                String?   @db.Text
  metadata           Json?
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  disabled           Boolean   @default(false)
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  models                    Model[]
  modelVersions             ModelVersion[]
  favorites                 Favorite[]
  downloads                 Download[]
  comments                  Comment[]
  ownedProjects             Project[]                  @relation("ProjectOwner")
  projectMembers            ProjectMember[]
  shareLinks                ShareLink[]
  selectionShares           SelectionShare[]
  supportTickets            SupportTicket[]
  ticketMessages            TicketMessage[]
  notifications             Notification[]
  inquiries                 Inquiry[]
  inquiryMessages           InquiryMessage[]
  assignedInquiries         Inquiry[]                  @relation("InquirySalesAssignee")
  salesAssignedInquiries    Inquiry[]                  @relation("InquirySalesAssignedBy")
  uploadedProductWallImages ProductWallImage[]         @relation("ProductWallUploads")
  reviewedProductWallImages ProductWallImage[]         @relation("ProductWallReviews")
  productWallFavorites      ProductWallImageFavorite[]
  generatedInviteCodes      InviteCode[]               @relation("InviteCodeGenerator")
  usedInviteCode            InviteCode?                @relation("InviteCodeUser")

  @@index([role, createdAt], map: "users_role_created_at_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model ProductWallImage {
  id              String  @id @default(uuid())
  title           String
  description     String? @db.Text
  kind            String  @default("公司产品") @db.VarChar(50)
  imageUrl        String  @map("image_url")
  previewImageUrl String? @map("preview_image_url")
  ratio           String  @default("4 / 5") @db.VarChar(20)
  tags            Json?
  sortOrder       Int     @default(0) @map("sort_order")
  status          String  @default("pending") @db.VarChar(20)
  uploaderId      String? @map("uploader_id")
  uploader        User?   @relation("ProductWallUploads", fields: [uploaderId], references: [id], onDelete: SetNull)

  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  reviewer     User?     @relation("ProductWallReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectReason String?   @map("reject_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  favorites ProductWallImageFavorite[]

  @@index([status])
  @@index([kind])
  @@index([sortOrder])
  @@index([createdAt])
  @@index([uploaderId])
  @@index([reviewedById], map: "product_wall_images_reviewed_by_id_idx")
  @@index([reviewedAt], map: "product_wall_images_reviewed_at_idx")
  @@index([status, kind, sortOrder])
  @@index([status, sortOrder, createdAt], map: "product_wall_images_status_sort_order_created_at_idx")
  @@index([kind, sortOrder], map: "product_wall_images_kind_sort_order_idx")
  @@map("product_wall_images")
}

model ProductWallImageFavorite {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId   String           @map("image_id")
  image     ProductWallImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([userId, imageId])
  @@index([userId])
  @@index([imageId], map: "product_wall_image_favorites_image_id_idx")
  @@index([userId, createdAt], map: "product_wall_image_favorites_user_id_created_at_idx")
  @@map("product_wall_image_favorites")
}

model ProductWallCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("product_wall_categories")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
  INTERNAL
}

model InviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  note        String?
  expiresAt   DateTime? @map("expires_at")
  status      String    @default("active")
  createdById String    @map("created_by_id")
  createdBy   User      @relation("InviteCodeGenerator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?   @unique @map("used_by_id")
  usedBy      User?     @relation("InviteCodeUser", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  usedAt      DateTime? @map("used_at")

  @@index([code])
  @@index([createdById, createdAt], map: "invite_codes_created_by_id_created_at_idx")
  @@index([status], map: "invite_codes_status_idx")
  @@index([expiresAt], map: "invite_codes_expires_at_idx")
  @@map("invite_codes")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  coverImage  String?  @map("cover_image")
  ownerId     String   @map("owner_id")
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members ProjectMember[]
  models  Model[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(VIEWER)
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

model Model {
  id             String    @id @default(uuid())
  name           String
  description    String?
  partNumber     String?   @map("part_number")
  category       String?
  categoryId     String?   @map("category_id")
  categoryRef    Category? @relation(fields: [categoryId], references: [id])
  originalName   String    @map("original_name")
  originalFormat String    @map("original_format")
  originalSize   Int       @map("original_size")
  gltfUrl        String    @map("gltf_url")
  gltfSize       Int       @map("gltf_size")
  thumbnailUrl   String?   @map("thumbnail_url")
  dimensions     String?
  format         String
  fileModifiedAt DateTime? @map("file_modified_at")
  status         String    @default("processing")
  currentVersion Int       @default(1) @map("current_version")
  downloadCount  Int       @default(0) @map("download_count")
  uploadPath     String?   @map("upload_path")
  metadata       Json?
  previewMeta    Json?     @map("preview_meta")
  projectId      String?   @map("project_id")
  project        Project?  @relation(fields: [projectId], references: [id])

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  versions   ModelVersion[]
  favorites  Favorite[]
  downloads  Download[]
  comments   Comment[]
  shareLinks ShareLink[]

  groupId      String?     @map("group_id")
  group        ModelGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupPrimary ModelGroup? @relation("GroupPrimary")

  drawingUrl  String? @map("drawing_url")
  drawingName String? @map("drawing_name")
  drawingSize Int?    @map("drawing_size")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([categoryId])
  @@index([createdById])
  @@index([createdAt])
  @@index([projectId])
  @@index([groupId])
  @@index([status, createdAt])
  @@index([status, categoryId, createdAt])
  @@index([status, updatedAt], map: "models_status_updated_at_idx")
  @@index([status, format, createdAt], map: "models_status_format_created_at_idx")
  @@index([status, gltfSize], map: "models_status_gltf_size_idx")
  @@index([status, categoryId, name], map: "models_status_category_id_name_idx")
  @@index([status, downloadCount, createdAt], map: "models_status_download_count_created_at_idx")
  @@index([name])
  @@index([name, status])
  @@map("models")
}

model ModelVersion {
  id            String   @id @default(uuid())
  modelId       String   @map("model_id")
  model         Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  versionNumber Int      @map("version_number")
  fileKey       String   @map("file_key")
  format        String
  fileSize      Int      @map("file_size")
  previewMeta   Json?    @map("preview_meta")
  vertexCount   Int?     @map("vertex_count")
  faceCount     Int?     @map("face_count")
  changeLog     String?  @map("change_log")
  createdById   String   @map("created_by_id")
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([modelId])
  @@map("model_versions")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   String   @map("model_id")
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, modelId])
  @@index([userId])
  @@index([userId, createdAt], map: "favorites_user_id_created_at_idx")
  @@index([modelId], map: "favorites_model_id_idx")
  @@map("favorites")
}

model Download {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   String   @map("model_id")
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  format    String
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([modelId])
  @@index([modelId, createdAt], map: "downloads_model_id_created_at_idx")
  @@index([createdAt], map: "downloads_created_at_idx")
  @@index([format], map: "downloads_format_idx")
  @@index([format, createdAt], map: "downloads_format_created_at_idx")
  @@map("downloads")
}

model Comment {
  id         String   @id @default(uuid())
  modelId    String   @map("model_id")
  model      Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  position3d Json?    @map("position_3d")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([modelId])
  @@index([modelId, createdAt])
  @@index([userId])
  @@map("comments")
}

model ShareLink {
  id            String    @id @default(uuid())
  modelId       String    @map("model_id")
  model         Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  token         String    @unique
  password      String?
  allowPreview  Boolean   @default(true) @map("allow_preview")
  allowDownload Boolean   @default(true) @map("allow_download")
  allowDrawing  Boolean   @default(true) @map("allow_drawing")
  downloadLimit Int       @default(0) @map("download_limit")
  downloadCount Int       @default(0) @map("download_count")
  viewCount     Int       @default(0) @map("view_count")
  expiresAt     DateTime? @map("expires_at")
  createdById   String    @map("created_by_id")
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([modelId])
  @@index([createdById], map: "share_links_created_by_id_idx")
  @@index([createdById, createdAt], map: "share_links_created_by_id_created_at_idx")
  @@index([createdAt], map: "share_links_created_at_idx")
  @@index([expiresAt], map: "share_links_expires_at_idx")
  @@map("share_links")
}

model SelectionShare {
  id           String   @id @default(uuid())
  token        String   @unique
  categorySlug String   @map("category_slug")
  specs        Json
  productIds   Json     @map("product_ids")
  viewCount    Int      @default(0) @map("view_count")
  createdById  String   @map("created_by_id")
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  /// 工单来源自动创建的快照（不显示在用户的分享列表里）
  autoCreated  Boolean  @default(false) @map("auto_created")

  @@index([createdById, createdAt], map: "selection_shares_created_by_id_created_at_idx")
  @@index([categorySlug], map: "selection_shares_category_slug_idx")
  @@index([createdAt], map: "selection_shares_created_at_idx")
  @@map("selection_shares")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([resource, createdAt], map: "audit_logs_resource_created_at_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_at_idx")
  @@index([resource, action, createdAt], map: "audit_logs_resource_action_created_at_idx")
  @@index([resourceId], map: "audit_logs_resource_id_idx")
  @@map("audit_logs")
}

model Category {
  id             String     @id @default(uuid())
  name           String
  icon           String     @default("folder")
  parentId       String?    @map("parent_id")
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Category[] @relation("CategoryTree")
  sortOrder      Int        @default(0) @map("sort_order")
  restricted     Boolean    @default(false)
  allowedRoles   String[]   @default([]) @map("allowed_roles")
  allowedUserIds String[]   @default([]) @map("allowed_user_ids")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  models Model[]

  @@index([parentId])
  @@index([parentId, sortOrder], map: "categories_parent_id_sort_order_idx")
  @@index([sortOrder], map: "categories_sort_order_idx")
  @@map("categories")
}

model SupportTicket {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  basePart       String?  @map("base_part")
  sourceUrl      String?  @map("source_url")
  classification String
  description    String
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt], map: "support_tickets_user_id_created_at_idx")
  @@index([status, createdAt], map: "support_tickets_status_created_at_idx")
  @@index([createdAt], map: "support_tickets_created_at_idx")
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String        @map("ticket_id")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id])
  content    String
  attachment String?       @map("attachment")
  isAdmin    Boolean       @default(false) @map("is_admin")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  relatedId String?  @map("related_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ThreadSizeEntry {
  id        String   @id @default(uuid())
  kind      String
  family    String?
  hoseKind  String?  @map("hose_kind")
  primary   String
  secondary String   @default("")
  meta      String   @default("")
  note      String   @default("")
  data      Json?
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind])
  @@index([family])
  @@index([hoseKind])
  @@index([sortOrder])
  @@index([kind, family, sortOrder], map: "thread_size_entries_kind_family_sort_order_idx")
  @@index([kind, hoseKind, sortOrder], map: "thread_size_entries_kind_hose_kind_sort_order_idx")
  @@map("thread_size_entries")
}

model ModelGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  primaryId   String?  @unique @map("primary_id")
  primary     Model?   @relation("GroupPrimary", fields: [primaryId], references: [id], onDelete: SetNull)
  models      Model[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("model_groups")
}

model SelectionCategory {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  description    String?
  icon           String?
  sortOrder      Int                @default(0) @map("sort_order")
  columns        Json
  image          String?
  optionImages   Json?              @map("option_images")
  optionOrder    Json?              @map("option_order")
  groupId        String?            @map("group_id")
  groupName      String?            @map("group_name")
  groupIcon      String?            @map("group_icon")
  groupImage     String?            @map("group_image")
  groupImageFit  String?            @map("group_image_fit")
  kind           String?            @default("product")
  catalogPdf     String?            @map("catalog_pdf")
  catalogShared  Boolean            @default(false) @map("catalog_shared")
  optionCatalogs Json?              @map("option_catalogs")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  products       SelectionProduct[]

  @@index([sortOrder], map: "selection_categories_sort_order_idx")
  @@index([groupId, sortOrder], map: "selection_categories_group_id_sort_order_idx")
  @@index([kind, sortOrder], map: "selection_categories_kind_sort_order_idx")
  @@index([catalogShared], map: "selection_categories_catalog_shared_idx")
  @@map("selection_categories")
}

model SelectionProduct {
  id         String            @id @default(uuid())
  categoryId String            @map("category_id")
  name       String
  modelNo    String?           @map("model_no")
  specs      Json
  image      String?
  pdfUrl     String?           @map("pdf_url")
  unit       String?           @default("个")
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  category   SelectionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isKit      Boolean @default(false) @map("is_kit")
  components Json?

  @@index([categoryId])
  @@index([modelNo])
  @@index([categoryId, sortOrder], map: "selection_products_category_id_sort_order_idx")
  @@index([categoryId, modelNo], map: "selection_products_category_id_model_no_idx")
  @@index([sortOrder], map: "selection_products_sort_order_idx")
  @@map("selection_products")
}

model Inquiry {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id])
  status            String    @default("submitted")
  remark            String?
  company           String?
  contactName       String?   @map("contact_name")
  contactPhone      String?   @map("contact_phone")
  contactAddress    String?   @map("contact_address")
  totalAmount       Decimal?  @map("total_amount") @db.Decimal(12, 2)
  adminRemark       String?   @map("admin_remark")
  salesAssigneeId   String?   @map("sales_assignee_id")
  salesAssignee     User?     @relation("InquirySalesAssignee", fields: [salesAssigneeId], references: [id], onDelete: SetNull)
  salesAssignedById String?   @map("sales_assigned_by_id")
  salesAssignedBy   User?     @relation("InquirySalesAssignedBy", fields: [salesAssignedById], references: [id], onDelete: SetNull)
  salesAssignedAt   DateTime? @map("sales_assigned_at")
  salesMode         String?   @map("sales_mode")
  salesChannel      String?   @map("sales_channel")
  salesRegion       String?   @map("sales_region")
  salesHandoffNote  String?   @map("sales_handoff_note") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  items    InquiryItem[]
  messages InquiryMessage[]

  @@index([userId])
  @@index([status])
  @@index([salesAssigneeId])
  @@index([salesAssignedAt])
  @@index([userId, createdAt], map: "inquiries_user_id_created_at_idx")
  @@index([status, createdAt], map: "inquiries_status_created_at_idx")
  @@index([salesAssigneeId, status, createdAt], map: "inquiries_sales_assignee_id_status_created_at_idx")
  @@index([createdAt], map: "inquiries_created_at_idx")
  @@map("inquiries")
}

model InquiryItem {
  id          String   @id @default(uuid())
  inquiryId   String   @map("inquiry_id")
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  productName String   @map("product_name")
  modelNo     String?  @map("model_no")
  specs       Json?
  unit        String?  @default("个")
  qty         Int      @default(1)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(12, 2)
  remark      String?

  @@index([inquiryId])
  @@index([productId], map: "inquiry_items_product_id_idx")
  @@index([modelNo], map: "inquiry_items_model_no_idx")
  @@map("inquiry_items")
}

model InquiryMessage {
  id         String   @id @default(uuid())
  inquiryId  String   @map("inquiry_id")
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  content    String
  attachment String?
  isAdmin    Boolean  @default(false) @map("is_admin")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([inquiryId])
  @@index([inquiryId, createdAt])
  @@index([userId], map: "inquiry_messages_user_id_idx")
  @@map("inquiry_messages")
}
