{
  "name": "3dparthub-client",
  "private": true,
  "version": "4.5.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-force-exit $(find src -name '*.test.ts')",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "verify:themes": "node scripts/verify-theme-contract.mjs",
    "create-theme": "node scripts/create-interface-theme.mjs",
    "verify:loading": "node scripts/verify-loading-contract.mjs",
    "verify:ux": "node scripts/verify-frontend-ux-contract.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "verify": "npm run verify:themes && npm run verify:loading && npm run verify:ux && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test",
    "preview": "vite preview",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/space-grotesk": "^5.2.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/react": "^10.51.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@vant/area-data": "^2.1.0",
    "axios": "^1.15.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.2",
    "read-excel-file": "^9.0.6",
    "swr": "^2.4.1",
    "three": "^0.184.0",
    "web-vitals": "^5.2.0",
    "write-excel-file": "^4.0.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "msw": "^2.13.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
