# ===== Docker compose production =====
# Root .env is read by docker-compose.yml. Local API development uses server/.env.
# Web public port. The API container always listens on 8000 internally.
PORT=3780
DATABASE_URL=postgresql://modeluser:modelpass@localhost:5432/3dparthub
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
STATIC_DIR=static
MAX_FILE_SIZE=104857600
ALLOWED_ORIGINS=http://your-server-ip:3780
# 站点对外地址（强烈建议设置）：邮件/通知里的链接一律用它，不再从请求头 Host 推断
# （防 Host 头投毒把密码重置等带 token 的链接改写到钓鱼域）。留空回退 Host 推断。
SITE_URL=https://your-domain.example.com
# 登录 Cookie secure 标志：生产 HTTPS 反代部署保持默认 true；
# 仅内网纯 HTTP 部署时显式设为 false（否则浏览器会拒收 secure cookie 导致无法登录）
AUTH_COOKIE_SECURE=true
TEMP_PREVIEW_UPLOAD_LIMIT_PER_HOUR=20
TEMP_PREVIEW_MAX_ACTIVE_PER_OWNER=5
TEMP_PREVIEW_TOTAL_ACTIVE_LIMIT=500
TEMP_PREVIEW_MAX_CONCURRENT_PER_OWNER=1

# ===== Admin Account (first run only) =====
ADMIN_USER=admin
ADMIN_EMAIL=admin@model.local
ADMIN_PASS=change-me-before-first-start

# ===== Docker compose production secrets =====
# DB_PASSWORD and REDIS_PASSWORD are used by docker-compose.yml.
DB_PASSWORD=change-me-before-docker-start
REDIS_PASSWORD=change-me-before-docker-start
BACKUP_SIGNING_SECRET=change-me-before-docker-start
BACKUP_ENCRYPTION_SECRET=change-me-before-docker-start
# 迁移到新服务器时，必须把旧服务器的 BACKUP_SIGNING_SECRET 原样复制过来，
# 否则旧备份会因签名密钥不一致而「签名校验失败」无法恢复；
# 若旧服务器启用过备份加密，BACKUP_ENCRYPTION_SECRET 也必须一致才能解密。
# （或恢复时勾选「跨服务器迁移：跳过签名校验」、或用「导入恢复」直接传 .tar.gz。）

# ===== Docker compose resource profile =====
# These are safe fallback values. Run scripts/tune-resources.sh .env before manual
# docker compose deployment to automatically write a profile for the current server.
RESOURCE_PROFILE=2G
API_MEMORY_LIMIT=900M
API_MEMORY_RESERVATION=256M
API_CPU_LIMIT=1.2
API_WORKERS=1
API_SHM_SIZE=256M
CONVERSION_WORKER_CONCURRENCY=1
POSTGRES_MEMORY_LIMIT=384M
POSTGRES_CPU_LIMIT=0.7
REDIS_MEMORY_LIMIT=256M
REDIS_CPU_LIMIT=0.3
REDIS_MAXMEMORY=96mb
WEB_MEMORY_LIMIT=128M
WEB_CPU_LIMIT=0.3
DB_CONNECTION_LIMIT=3

# ===== SMTP (optional, for registration codes) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ===== MinIO (optional, default: local storage) =====
# STORAGE_TYPE=minio
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=models
